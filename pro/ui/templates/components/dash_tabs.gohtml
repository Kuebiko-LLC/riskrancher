{{define "dash_tabs"}}
    <div class="tab-nav">
        <a href="/dashboard?tab=holding_pen" class="tab-btn {{if eq .CurrentTab "holding_pen"}}active{{end}}">
            📩 Holding Pen
            {{if gt .ReturnedCount 0}}
                <span class="notification-bubble">{{.ReturnedCount}}</span>
            {{end}}
        </a>
        <a href="/dashboard?tab=chute" class="tab-btn {{if eq .CurrentTab "chute"}}active{{end}}">🤠 The Chute (Assigned)</a>
        <a href="/dashboard?tab=verification" class="tab-btn {{if eq .CurrentTab "verification"}}active{{end}}">
            👀 Pending Verification
            {{if gt .CountVerification 0}}
                <span style="background: #ef4444; color: white; border-radius: 12px; padding: 2px 7px; font-size: 0.7rem; font-weight: bold; margin-left: 5px; box-shadow: 0 0 8px rgba(239, 68, 68, 0.6); animation: pulse 2s infinite;">{{.CountVerification}}</span>
            {{end}}
        </a>
        <a href="/dashboard?tab=archives" class="tab-btn {{if eq .CurrentTab "archives"}}active{{end}}">
            🗄️ The Archives
        </a>
    </div>
{{end}}