{{define "admin_config"}}
    <div id="tab-config" class="tab-pane">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h3 style="margin: 0;">Personnel</h3>
                    <button id="openUserModal" class="btn" style="padding: 6px 12px; font-size: 0.85rem;">+ Add User</button>
                </div>
                <table style="font-size: 0.9rem; width: 100%;">
                    <thead><tr><th style="text-align: left;">Name</th><th style="text-align: left;">Role</th><th style="text-align: right;">Actions</th></tr></thead>
                    <tbody>
                    {{range .Users}}
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 8px 0;"><strong>{{.FullName}}</strong><br><span style="font-family: monospace; font-size: 0.8rem; color: #64748b;">{{.Email}}</span></td>
                            <td><span class="badge" style="background: #1e293b;">{{.GlobalRole}}</span></td>
                            <td style="text-align: right;">
                                <button class="btn btn-secondary" style="padding: 2px 6px; font-size: 0.75rem;" onclick="resetPassword({{.ID}})" title="Reset Password"></button>
                                <button class="btn btn-secondary" style="padding: 2px 6px; font-size: 0.75rem;" onclick="editRole({{.ID}}, '{{.GlobalRole}}')" title="Change Role"></button>
                                <button class="btn btn-secondary" style="padding: 2px 6px; font-size: 0.75rem; color: #dc2626; border-color: #fca5a5;" onclick="deleteUser({{.ID}})" title="Deactivate"></button>
                            </td>
                        </tr>
                    {{end}}
                    </tbody>
                </table>
            </div>

            <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h3 style="margin: 0;">Source Routing</h3>
                    <button id="openRuleModal" class="btn" style="padding: 6px 12px; font-size: 0.85rem; background: #8b5cf6; color: white;">+ Add Rule</button>
                </div>
                <table style="font-size: 0.9rem; width: 100%;">
                    <thead><tr><th style="text-align: left;">Trigger</th><th style="text-align: left;">Match & Assignee</th><th style="text-align: right;">Actions</th></tr></thead>
                    <tbody>
                    {{range .Rules}}
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 8px 0;"><strong>{{.RuleType}}</strong></td>
                            <td><span style="font-family: monospace; color: #2563eb;">{{.MatchValue}}</span><br><span style="font-size: 0.8rem; color: #475569;">&rarr; {{.Assignee}}</span></td>
                            <td style="text-align: right;"><button class="btn btn-secondary" style="padding: 2px 6px; font-size: 0.75rem; color: #dc2626; border-color: #fca5a5;" onclick="deleteRule({{.ID}})" title="Delete Rule"></button></td>
                        </tr>
                    {{else}}
                        <tr><td colspan="3" style="text-align: center; color: #94a3b8; padding: 10px;">No active routing rules.</td></tr>
                    {{end}}
                    </tbody>
                </table>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
            <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h3 style="margin: 0;">SLA Policies & System Time</h3>
                    <button id="saveConfigBtn" class="btn" style="padding: 6px 12px; font-size: 0.85rem;">Save Changes</button>
                </div>
                <div style="display: flex; gap: 30px;">
                    <div style="flex: 1; padding: 15px; background: #f8fafc; border-radius: 6px; border: 1px solid #e2e8f0;">
                        <h4 style="margin-top: 0;">Base Configuration</h4>
                        <label>System Timezone:</label>
                        <select id="configTimezone" style="width: 100%; padding: 6px; margin-bottom: 10px;">
                            <option value="America/New_York" {{if eq .Config.Timezone "America/New_York"}}selected{{end}}>Eastern Time (ET)</option>
                            <option value="America/Chicago" {{if eq .Config.Timezone "America/Chicago"}}selected{{end}}>Central Time (CT)</option>
                            <option value="America/Denver" {{if eq .Config.Timezone "America/Denver"}}selected{{end}}>Mountain Time (MT)</option>
                            <option value="America/Los_Angeles" {{if eq .Config.Timezone "America/Los_Angeles"}}selected{{end}}>Pacific Time (PT)</option>
                            <option value="UTC" {{if eq .Config.Timezone "UTC"}}selected{{end}}>UTC (Universal)</option>
                        </select>
                        <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                            <div style="flex: 1;"><label>Biz Start:</label><input type="number" id="configBizStart" value="{{.Config.BusinessStart}}" style="width: 100%; padding: 6px;"></div>
                            <div style="flex: 1;"><label>Biz End:</label><input type="number" id="configBizEnd" value="{{.Config.BusinessEnd}}" style="width: 100%; padding: 6px;"></div>
                        </div>
                        <label>Default Exception (Days):</label>
                        <input type="number" id="configDefExt" value="{{.Config.DefaultExtensionDays}}" style="width: 100%; padding: 6px;">
                    </div>
                    <div style="flex: 2;">
                        <div style="margin-bottom: 10px; display: flex; justify-content: space-between;">
                            <h4 style="margin: 0;">SLA Matrix</h4>
                            <select id="slaDomainFilter" style="padding: 4px; font-size: 0.85rem;">
                                <option value="Vulnerability">Vulnerability</option>
                                <option value="Privacy">Privacy</option>
                                <option value="Compliance">Compliance</option>
                                <option value="Incident">Incident</option>
                            </select>
                        </div>
                        <table style="font-size: 0.85rem; width: 100%; text-align: left;">
                            <thead><tr><th style="padding-bottom: 5px;">Severity</th><th>Triage</th><th>Patch</th><th>Ext.</th></tr></thead>
                            <tbody>
                            {{range .SLAs}}
                                <tr class="sla-row" data-domain="{{.Domain}}">
                                    <td style="padding: 4px 0;"><span class="badge {{.Severity | lower}}">{{.Severity}}</span></td>
                                    <td><input type="number" class="sla-triage" value="{{.DaysToTriage}}" style="width: 45px;"></td>
                                    <td><input type="number" class="sla-patch" value="{{.DaysToRemediate}}" style="width: 45px;"></td>
                                    <td><input type="number" class="sla-ext" value="{{.MaxExtensions}}" style="width: 35px;"></td>
                                </tr>
                            {{end}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; display: flex; flex-direction: column;">
                <h3 style="margin: 0 0 15px 0;">Operations</h3>
                <div style="margin-bottom: 20px;">
                    <label style="font-weight: bold;">Known Exploited Vulnerabilities</label>
                    <p style="font-size: 0.8rem; color: #64748b; margin: 4px 0 8px 0;">Load the CISA KEV catalog JSON you downloaded. Nothing is fetched. Findings naming a listed CVE are flagged now and as they arrive.</p>
                    <div style="display: flex; gap: 10px; margin-top: 5px;">
                        <input type="file" id="kevCatalogFile" accept=".json,application/json" style="flex: 1; font-size: 0.85rem;">
                        <button class="btn btn-secondary" onclick="loadKEVCatalog()">Load catalog</button>
                    </div>
                    <p id="kevLoadResult" style="font-size: 0.8rem; color: #475569; margin: 6px 0 0 0;">{{if gt .KEV.Loaded 0}}{{.KEV.Loaded}} CVEs loaded, newest {{.KEV.LastAdded}}, flagging {{.KEV.FlaggedOpen}} open findings.{{else}}No catalog loaded.{{end}}</p>
                </div>
                <div style="margin-bottom: 20px;">
                    <label style="font-weight: bold;">Data Portability</label>
                    <a href="/api/admin/export" class="btn btn-secondary" style="display: block; text-align: center; margin-top: 5px; background: #e0e7ff; color: #3730a3; border-color: #c7d2fe;">Export JSON State</a>
                </div>
                <div style="margin-top: auto; padding-top: 15px; border-top: 1px solid #e2e8f0;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 0.85rem; color: #475569;">Version: <strong>{{.Version}} ({{.Commit}})</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{{end}}